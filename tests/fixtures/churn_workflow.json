{
  "id": "churn-uc1",
  "name": "Churn risk scoring",
  "active": false,
  "nodes": [
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Daily schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "days", "daysInterval": 1 }
          ]
        }
      }
    },
    {
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Read active accounts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [460, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT account_id, last_login_at, monthly_spend, support_tickets FROM accounts WHERE status = 'active'"
      }
    },
    {
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Compute churn features",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "language": "javaScript",
        "jsCode": "return items.map(item => ({ json: { account_id: item.json.account_id, days_since_login: 30, spend_trend: -0.2, tickets: item.json.support_tickets } }));"
      }
    },
    {
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Score churn risk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "POST",
        "url": "https://models.internal/churn/score",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "features", "value": "={{ $json }}" }
          ]
        }
      }
    },
    {
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Alert on high risk",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1120, 300],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "#retention",
        "text": "=High churn risk: account {{ $json.account_id }} ({{ $json.risk }})"
      }
    }
  ],
  "connections": {
    "Daily schedule": {
      "main": [
        [
          { "node": "Read active accounts", "type": "main", "index": 0 }
        ]
      ]
    },
    "Read active accounts": {
      "main": [
        [
          { "node": "Compute churn features", "type": "main", "index": 0 }
        ]
      ]
    },
    "Compute churn features": {
      "main": [
        [
          { "node": "Score churn risk", "type": "main", "index": 0 }
        ]
      ]
    },
    "Score churn risk": {
      "main": [
        [
          { "node": "Alert on high risk", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    { "id": "1", "name": "use-case:churn" }
  ],
