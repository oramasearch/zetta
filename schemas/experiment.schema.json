{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "allocations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "fraction": {
            "exclusiveMinimum": 0,
            "maximum": 1,
            "type": "number"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "tier": {
            "enum": [
              "holdout",
              "treatment",
              "exploration",
              "below_line"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "tier",
          "fraction"
        ],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "created": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "name",
    "seed",
    "allocations",
    "created"
  ],
  "title": "zetta.Experiment",
  "type": "object"
}
