{
  "$id": "https://zetta.orama.com/schemas/partition_scan_request.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "where": {
      "description": "a WHERE predicate: {column, op, value}, {and: [...]}, {or: [...]} or {not: ...} (#912)",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "column": {
              "minLength": 1,
              "type": "string"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "le",
                "gt",
                "ge"
              ]
            },
            "value": {}
          },
          "required": [
            "column",
            "op",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "and": {
              "items": {
                "$ref": "#/definitions/where"
              },
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "and"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "or": {
              "items": {
                "$ref": "#/definitions/where"
              },
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "or"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/definitions/where"
            }
          },
          "required": [
            "not"
          ],
          "type": "object"
        }
      ]
    }
  },
  "description": "A scatter-gather SELECT's ask of one partition owner: scan these partitions of this table, filter them, and return rows or per-group aggregate partials (#833).",
  "properties": {
    "aggregates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "column": {
            "type": "string"
          },
          "func": {
            "enum": [
              "count",
              "sum",
              "min",
              "max",
              "avg"
            ]
          }
        },
        "required": [
          "func"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "columns": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "group_by": {
      "type": "string"
    },
    "keep": {
      "description": "the most rows one partition returns: the SELECT's offset + limit (#1021)",
      "minimum": 0,
      "type": "integer"
    },
    "order_by": {
      "description": "sort each partition's rows by these keys before keeping `keep` (#1021)",
      "items": {
        "additionalProperties": false,
        "properties": {
          "column": {
            "minLength": 1,
            "type": "string"
          },
          "descending": {
            "type": "boolean"
          }
        },
        "required": [
          "column"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "partitions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "table": {
      "minLength": 1,
      "type": "string"
    },
    "where": {
      "$ref": "#/definitions/where"
    }
  },
  "required": [
    "table",
    "partitions"
  ],
  "title": "PartitionScanRequest",
  "type": "object"
}
