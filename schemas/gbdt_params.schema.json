{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Hyperparameters for histogram gradient-boosted decision tree training (binary logistic or squared error). All fields are optional; an omitted field takes its default.",
  "properties": {
    "holdout_fraction": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "l2_regularization": {
      "minimum": 0,
      "type": "number"
    },
    "learning_rate": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "max_bins": {
      "minimum": 2,
      "type": "integer"
    },
    "max_depth": {
      "minimum": 1,
      "type": "integer"
    },
    "min_child_hessian": {
      "minimum": 0,
      "type": "number"
    },
    "min_split_gain": {
      "minimum": 0,
      "type": "number"
    },
    "num_trees": {
      "minimum": 1,
      "type": "integer"
    },
    "objective": {
      "enum": [
        "binary_logistic",
        "squared_error",
        "lambdamart"
      ],
      "type": "string"
    }
  },
  "title": "zetta.ml.GbdtParams",
  "type": "object"
}
