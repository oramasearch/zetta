{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "allocation": {
      "minLength": 1,
      "type": "string"
    },
    "assigned_at": {
      "type": "string"
    },
    "bucket": {
      "exclusiveMaximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "entity": {
      "minLength": 1,
      "type": "string"
    },
    "exempt": {
      "type": "boolean"
    },
    "exemption_actor": {
      "type": "string"
    },
    "exemption_reason": {
      "type": "string"
    },
    "experiment": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "propensity": {
      "exclusiveMinimum": 0,
      "maximum": 1,
      "type": "number"
    },
    "tier": {
      "enum": [
        "holdout",
        "treatment",
        "exploration",
        "below_line"
      ],
      "type": "string"
    }
  },
  "required": [
    "experiment",
    "entity",
    "allocation",
    "tier",
    "propensity",
    "bucket",
    "exempt",
    "exemption_reason",
    "exemption_actor",
    "assigned_at"
  ],
  "title": "zetta.ExperimentAssignment",
  "type": "object"
}
