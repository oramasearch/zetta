{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "A connector credential sealed with AES-256-GCM under a key derived from a root secret held outside the replicated catalogue (#1230). The connection name is the associated data.",
  "properties": {
    "alg": {
      "const": "AES-256-GCM",
      "type": "string"
    },
    "ciphertext": {
      "pattern": "^([0-9a-f]{2})*$",
      "type": "string"
    },
    "kid": {
      "pattern": "^[0-9a-f]{16}$",
      "type": "string"
    },
    "nonce": {
      "pattern": "^[0-9a-f]{24}$",
      "type": "string"
    },
    "tag": {
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "v": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "v",
    "alg",
    "kid",
    "nonce",
    "ciphertext",
    "tag"
  ],
  "title": "zetta.SealedCredential",
  "type": "object"
}
