{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "solutions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string"
          },
          "graph": {
            "additionalProperties": false,
            "properties": {
              "edges": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "from": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "data_flow",
                        "control"
                      ],
                      "type": "string"
                    },
                    "to": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "nodes": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "attributes": {
                      "type": "object"
                    },
                    "id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "connect",
                        "clean",
                        "model",
                        "index",
                        "serve",
                        "act"
                      ],
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "name"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "nodes",
              "edges"
            ],
            "type": "object"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "summary",
          "category",
          "graph"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "solutions"
  ],
  "title": "zetta.SolutionCatalog",
  "type": "object"
}
