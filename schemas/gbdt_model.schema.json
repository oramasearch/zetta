{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "zetta.ml.GbdtModel",
  "description": "The serialized weights body of a trained histogram GBDT (binary logistic): a base score plus an ordered ensemble of regression trees over a fixed feature ordering. This is the JSON document stored as a Model's weights body and re-validated when read back from disk or a peer.",
  "type": "object",
  "properties": {
    "objective": { "type": "string", "enum": ["binary_logistic"] },
    "base_score": { "type": "number" },
    "learning_rate": { "type": "number" },
    "feature_names": {
      "type": "array",
      "items": { "type": "string" }
    },
    "trees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "feature": { "type": "integer" },
                "threshold": { "type": "number" },
                "left": { "type": "integer" },
                "right": { "type": "integer" },
                "value": { "type": "number" },
                "cover": { "type": "number", "description": "Training weight (sum of Hessians) reaching this node — the background branch probabilities exact TreeSHAP integrates over." }
              },
              "required": ["feature", "threshold", "left", "right", "value", "cover"],
              "additionalProperties": false
            }
          }
        },
        "required": ["nodes"],
        "additionalProperties": false
      }
    }
  },
  "required": ["objective", "base_score", "learning_rate", "feature_names", "trees"],
  "additionalProperties": false
}
