{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "join_token": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "retired_join_tokens": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 4,
      "type": "array"
    },
    "version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "join_token"
  ],
  "title": "zetta.ClusterSecret",
  "type": "object"
}
