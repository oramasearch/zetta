{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "allocator_free_held_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "allocator_in_use_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "attributed_memory_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "cpu_cores": {
      "minimum": 0,
      "type": "integer"
    },
    "cpu_percent": {
      "type": "number"
    },
    "gpu_percent": {
      "type": "number"
    },
    "memory_explained_percent": {
      "type": "number"
    },
    "memory_percent": {
      "type": "number"
    },
    "memory_total_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "memory_used_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "net_percent": {
      "type": "number"
    },
    "net_rx_bytes_per_sec": {
      "minimum": 0,
      "type": "integer"
    },
    "net_tx_bytes_per_sec": {
      "minimum": 0,
      "type": "integer"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "process_peak_rss_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "process_rss_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "sampled_at": {
      "type": "string"
    },
    "storage_census": {
      "additionalProperties": false,
      "properties": {
        "age_seconds": {
          "minimum": 0,
          "type": "number"
        },
        "buckets": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "bucket": {
                "type": "string"
              },
              "bytes": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "bucket",
              "bytes"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "type": "array"
        },
        "buckets_omitted": {
          "minimum": 0,
          "type": "integer"
        },
        "kinds": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "measured_at": {
          "minLength": 1,
          "type": "string"
        },
        "total_bytes": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "measured_at",
        "age_seconds",
        "total_bytes",
        "kinds",
        "buckets"
      ],
      "type": "object"
    },
    "storage_percent": {
      "type": "number"
    },
    "storage_total_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "storage_used_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "unattributed_memory_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "vram_total_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "vram_used_bytes": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "node_id",
    "sampled_at"
  ],
  "title": "zetta.NodeMetrics",
  "type": "object"
}
