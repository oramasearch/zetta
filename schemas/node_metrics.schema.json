{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "cpu_cores": {
      "minimum": 0,
      "type": "integer"
    },
    "cpu_percent": {
      "type": "number"
    },
    "gpu_percent": {
      "type": "number"
    },
    "memory_percent": {
      "type": "number"
    },
    "memory_total_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "memory_used_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "net_percent": {
      "type": "number"
    },
    "net_rx_bytes_per_sec": {
      "minimum": 0,
      "type": "integer"
    },
    "net_tx_bytes_per_sec": {
      "minimum": 0,
      "type": "integer"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "sampled_at": {
      "type": "string"
    },
    "storage_percent": {
      "type": "number"
    },
    "storage_total_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "storage_used_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "vram_total_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "vram_used_bytes": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "node_id",
    "sampled_at"
  ],
  "title": "zetta.NodeMetrics",
  "type": "object"
}
