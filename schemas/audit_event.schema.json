{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "not": {
          "required": [
            "summary"
          ]
        }
      },
      "if": {
        "properties": {
          "action": {
            "const": "data_access_summary"
          }
        }
      },
      "then": {
        "required": [
          "summary"
        ]
      }
    }
  ],
  "properties": {
    "action": {
      "enum": [
        "graph_created",
        "graph_dropped",
        "graph_deployed",
        "graph_approved",
        "data_access",
        "data_access_summary",
        "job_created",
        "job_finished",
        "key_issued",
        "key_revoked",
        "provision_requested",
        "cloud_inspected",
        "dataset_added",
        "consent_requested",
        "consent_decided",
        "consent_bypassed",
        "decision_policy_created",
        "decision_policy_updated",
        "decision_approved",
        "pubsub_topic_updated",
        "pubsub_event_updated",
        "pubsub_event_deleted",
        "audit_purged",
        "data_changed",
        "egress_denied"
      ],
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "allowed": {
      "type": "boolean"
    },
    "detail": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "minimum": 1,
          "type": "integer"
        },
        "events_delivered": {
          "minimum": 0,
          "type": "integer"
        },
        "scope": {
          "type": "string"
        },
        "window_ended": {
          "type": "string"
        },
        "window_started": {
          "type": "string"
        }
      },
      "required": [
        "calls",
        "events_delivered",
        "scope",
        "window_started",
        "window_ended"
      ],
      "type": "object"
    },
    "target": {
      "type": "string"
    },
    "time": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "time"
  ],
  "title": "zetta.AuditEvent",
  "type": "object"
}
