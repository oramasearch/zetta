{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "type": "string"
    },
    "crashes": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "recent_errors": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "submitted_at": {
      "type": "string"
    },
    "traces": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "spans": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "trace_id": {
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "spans"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "description",
    "submitted_at",
    "version",
    "platform",
    "traces",
    "recent_errors",
    "crashes"
  ],
  "title": "zetta.FeedbackBundle",
  "type": "object"
}
