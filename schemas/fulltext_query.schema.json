{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "backend": {
      "type": "string"
    },
    "database": {
      "minLength": 1,
      "type": "string"
    },
    "database_id": {
      "minLength": 1,
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "fields": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "kind": {
      "enum": [
        "search",
        "vector",
        "feature"
      ],
      "type": "string"
    },
    "return_fields": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "statistics": {
      "additionalProperties": false,
      "properties": {
        "doc_count": {
          "minimum": 0,
          "type": "integer"
        },
        "fields": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "doc_count": {
                "minimum": 0,
                "type": "integer"
              },
              "total_len": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "total_len",
              "doc_count"
            ],
            "type": "object"
          },
          "type": "object"
        },
        "term_doc_freq": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        }
      },
      "required": [
        "doc_count",
        "term_doc_freq",
        "fields"
      ],
      "type": "object"
    },
    "table": {
      "minLength": 1,
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "term": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "top_k": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "table",
    "kind",
    "fields",
    "term"
  ],
  "title": "zetta.FulltextQueryRequest",
  "type": "object"
}
