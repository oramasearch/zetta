{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "created": {
      "type": "string"
    },
    "exposed": {
      "type": "boolean"
    },
    "feature_schema": {
      "type": "object"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "minLength": 1,
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "pipeline_name": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "run": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "weights": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "size",
        "sha256"
      ],
      "type": "object"
    }
  },
  "required": [
    "kind"
  ],
  "title": "zetta.Model",
  "type": "object"
}
