{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "acknowledgement": {
      "type": "object"
    },
    "actor": {
      "type": "string"
    },
    "agent_version": {
      "minLength": 1,
      "type": "string"
    },
    "attempts": {
      "minimum": 0,
      "type": "integer"
    },
    "cell": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "minLength": 1,
      "type": "string"
    },
    "currency": {
      "minLength": 1,
      "type": "string"
    },
    "decision_log": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "driver_report": {
      "type": "object"
    },
    "endpoint": {
      "minLength": 1,
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "last_error": {
      "type": "string"
    },
    "ledger_action_id": {
      "type": "string"
    },
    "max_attempts": {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "model_version": {
      "minLength": 1,
      "type": "string"
    },
    "policy_version": {
      "minLength": 1,
      "type": "string"
    },
    "publication_id": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "spec_digest": {
      "pattern": "^([0-9a-f]{64})?$",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "delivered",
        "blocked",
        "dead_letter"
      ],
      "type": "string"
    },
    "timeout_seconds": {
      "maximum": 300,
      "minimum": 1,
      "type": "integer"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "publication_id",
    "run_id",
    "title",
    "driver_report",
    "decision_log",
    "endpoint",
    "idempotency_key",
    "max_attempts",
    "attempts",
    "status",
    "ledger_action_id",
    "last_error",
    "acknowledgement",
    "model_version",
    "policy_version",
    "agent_version",
    "cell",
    "currency",
    "created_at",
    "updated_at"
  ],
  "title": "zetta.ReportPublication",
  "type": "object"
}
