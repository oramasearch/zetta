*.dll
*.exe

# CMake-generated
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
Makefile
compile_commands.json
.cmake/

# FetchContent
/_deps/

# IDE
.vscode/settings.json
