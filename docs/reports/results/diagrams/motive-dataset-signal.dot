// How the stand-in dataset carries a churn signal that is real but not trivial.
//
// Generated source for motive-dataset-signal.svg. Render with:
//   dot -Tsvg motive-dataset-signal.dot -o motive-dataset-signal.svg
//
// The point of the picture: four independent troubles, each read by a DIFFERENT
// channel, combining into a probability the label is drawn from. No single column
// predicts churn, which is what makes the model's job real.
digraph motive_signal {
  rankdir=LR;
  bgcolor="white";
  fontname="IBM Plex Sans,Helvetica,Arial,sans-serif";
  node [fontname="IBM Plex Sans,Helvetica,Arial,sans-serif", fontsize=11,
        shape=box, style="rounded,filled", penwidth=1.2, margin="0.16,0.09"];
  edge [fontname="IBM Plex Sans,Helvetica,Arial,sans-serif", fontsize=9,
        color="#525252", penwidth=1.1];

  subgraph cluster_latent {
    label="What is actually going wrong (never written to any column)";
    fontsize=11; color="#c6c6c6"; style="rounded"; margin=12;
    r [label="Device reliability", fillcolor="#e8daff", color="#8a3ffc"];
    b [label="Billing friction", fillcolor="#e8daff", color="#8a3ffc"];
    q [label="Buyer disengagement", fillcolor="#e8daff", color="#8a3ffc"];
    k [label="Support backlog", fillcolor="#e8daff", color="#8a3ffc"];
  }

  subgraph cluster_channel {
    label="The channel that shows it";
    fontsize=11; color="#c6c6c6"; style="rounded"; margin=12;
    cr [label="Support escalations", fillcolor="#d0e2ff", color="#0f62fe"];
    cb [label="Billing disputes", fillcolor="#d0e2ff", color="#0f62fe"];
    cq [label="Sales calls stop being taken", fillcolor="#d0e2ff", color="#0f62fe"];
    ck [label="Unresolved contacts · chat deflection · NPS", fillcolor="#d0e2ff", color="#0f62fe"];
  }

  subgraph cluster_feature {
    label="The column a model sees — and its solo predictive power";
    fontsize=11; color="#c6c6c6"; style="rounded"; margin=12;
    fr [label="escalations_90d\nAUC 0.642", fillcolor="#defbe6", color="#24a148"];
    fb [label="billing_disputes_180d\nAUC 0.600", fillcolor="#defbe6", color="#24a148"];
    fq [label="days_since_last_sales_touch\nAUC 0.586", fillcolor="#defbe6", color="#24a148"];
    fk [label="unresolved_contacts_90d\nAUC 0.583", fillcolor="#defbe6", color="#24a148"];
    fs [label="seats · tenure_days\nAUC ~0.52 — the SIZE control,\nso volume is not mistaken for risk",
        fillcolor="#f4f4f4", color="#a8a8a8"];
  }

  label_node [label="p(churn) = logistic(weighted sum)\nthe label is DRAWN from p —\nthe overlap is real, not injected",
              shape=box, fillcolor="#fff8e1", color="#f1c21b", fontsize=11];
  outcome [label="Churn rate 17.5%\nTrained model (gradient-boosted trees): AUC 0.868\nBest single column alone: 0.642",
           shape=box, fillcolor="#defbe6", color="#24a148", fontsize=11];

  r -> cr -> fr;
  b -> cb -> fb;
  q -> cq -> fq;
  k -> ck -> fk;

  r -> label_node [style=dashed]; b -> label_node [style=dashed];
  q -> label_node [style=dashed]; k -> label_node [style=dashed];
  label_node -> outcome;
  fr -> outcome [style=dotted]; fb -> outcome [style=dotted];
  fq -> outcome [style=dotted]; fk -> outcome [style=dotted];
  fs -> outcome [style=dotted];

  note [label="Why it matters that no column is decisive:\na dataset where one column predicts the label teaches\nnothing, and a model trained on it falls over on the\nfirst real account that breaks the pattern.",
        shape=note, fillcolor="#f4f4f4", color="#a8a8a8", fontsize=9];
  outcome -> note [style=invis];
}
