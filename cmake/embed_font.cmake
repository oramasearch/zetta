# embed_font.cmake
#
# Reads a binary file (intended for a TTF font) and emits a C++ header
# exposing it as `inline constexpr unsigned char <SYMBOL>[]` plus a
# `<SYMBOL>_len`. Invoked from CMakeLists.txt at configure time via
# `cmake -P` so the runtime never has to find the source tree.
#
# Inputs (defined on the command line):
#   IN_FILE  — path to the binary file to embed
#   OUT_FILE — path to write the generated header
#   SYMBOL   — C++ identifier for the byte array (e.g. kDroidSans)

if(NOT DEFINED IN_FILE OR NOT DEFINED OUT_FILE OR NOT DEFINED SYMBOL)
  message(FATAL_ERROR "embed_font.cmake requires IN_FILE, OUT_FILE, SYMBOL")
endif()

file(READ "${IN_FILE}" HEX HEX)
string(LENGTH "${HEX}" HEX_LEN)
math(EXPR BYTE_COUNT "${HEX_LEN} / 2")

# Turn "aabbcc..." into "0xaa,0xbb,0xcc,..." — C++ doesn't care about
# whitespace, so don't bother prettifying for a ~190KB blob.
string(REGEX REPLACE "(..)" "0x\\1," BYTES "${HEX}")

set(BODY "// Auto-generated by cmake/embed_font.cmake — DO NOT EDIT.\n")
string(APPEND BODY "#pragma once\n")
string(APPEND BODY "namespace zetta {\n")
string(APPEND BODY "inline constexpr unsigned char ${SYMBOL}[] = { ${BYTES} };\n")
string(APPEND BODY "inline constexpr unsigned ${SYMBOL}_len = ${BYTE_COUNT};\n")
string(APPEND BODY "}  // namespace zetta\n")

file(WRITE "${OUT_FILE}" "${BODY}")
